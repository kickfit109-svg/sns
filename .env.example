# ===== 投稿文の生成（必須）=====
ANTHROPIC_API_KEY=

# 生成に使うモデル（任意 / 既定: claude-sonnet-5）
SNSGROW_MODEL=claude-sonnet-5

# ===== X (旧Twitter) 自動投稿（任意）=====
# https://developer.x.com/ でアプリを作成し取得
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ===== Threads 自動投稿（任意）=====
# https://developers.facebook.com/ の Threads API から取得
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# note は公式の投稿APIが存在しないため自動投稿は非対応（下書き出力のみ）
